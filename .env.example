# ==============================================================================
# Stock Monitor - Configurazione di esempio.
# Copia in `.env` per docker-compose.yml oppure passa le variabili nel compose
# del NAS (docker-compose.nas.yml). I default corrispondono a backend/config.py.
# ==============================================================================

# --- Google Gemini AI (consigli finanziari e analisi on-demand) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Autenticazione & Sicurezza ---
# ⚠️ OBBLIGATORIO: sostituisci con una stringa lunga e casuale prima del deploy.
SECRET_KEY=change-me-with-a-long-random-string
ADMIN_USERNAME=admin
# ⚠️ OBBLIGATORIO: cambia la password di default prima del deploy.
ADMIN_PASSWORD=change-me
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- Bot Telegram (opzionale: notifiche e comandi interattivi) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_ENABLED=true

# --- Reddit (opzionale: usato solo per lo stato integrazione in Impostazioni;
#     il sentiment legge Reddit pubblico senza credenziali) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Database & Scheduler ---
DB_PATH=data/stock_monitor.db
ALERT_CHECK_INTERVAL_MINUTES=15
LOG_LEVEL=INFO

# --- Retention dati storici ---
PRICE_HISTORY_RETENTION_DAYS=400
SENTIMENT_RETENTION_DAYS=30
CLEANUP_BATCH_SIZE=500

# --- Analytics & Risk Metrics ---
RISK_FREE_RATE=0.02
