# ==============================================================================
# Stock Monitor - File di Configurazione (.env)
# ==============================================================================

# --- Google Gemini AI (Consigli Finanziari & Analisi On-Demand) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# --- Autenticazione & Sicurezza ---
SECRET_KEY=stock-monitor-super-secret-key-change-in-env-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- Bot Telegram (Opzionale per Notifiche & Comandi Interattivi) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_ENABLED=true

# --- Parametri Finanziari & Risk Metrics ---
RISK_FREE_RATE=0.02

# --- Database & Scheduler ---
DB_PATH=data/stock_monitor.db
ALERT_CHECK_INTERVAL_MINUTES=15
LOG_LEVEL=INFO
